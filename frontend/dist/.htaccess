# Apache / LiteSpeed (Hostinger) rules for the static site.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On

	# One canonical host: https://tidetotable.com.sg
	RewriteCond %{HTTPS} off [OR]
	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteRule ^ https://tidetotable.com.sg%{REQUEST_URI} [L,R=301]

	# /index.html -> / (avoid duplicate homepage URLs)
	RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
	RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

	# Earlier .html page names
	RewriteRule ^products\.html$ /products/ [L,R=301]
	RewriteRule ^contact(-us)?\.html$ /contact-us/ [L,R=301]

	# Old WordPress shop URLs -> new product page
	RewriteRule ^product-category/frozen-seafood/?$ /products/?category=seafood-ingredients [L,R=301]
	RewriteRule ^product-category/ready-to-cook-meals/?$ /products/?category=semi-processed [L,R=301]
	RewriteRule ^product-category/japanese-cuisine/?$ /products/?category=japanese-product [L,R=301]
	RewriteRule ^product-category/ /products/ [L,R=301]
	RewriteRule ^product/ /products/ [L,R=301]
	RewriteRule ^(shop|cart|checkout|my-account|wishlist|compare)(/.*)?$ /products/ [L,R=301]

	# Old WordPress pages whose content now lives on the homepage
	RewriteRule ^(about-us|supply-chain)/?$ / [L,R=301]

	# Theme demo content and WordPress endpoints that no longer exist
	RewriteRule ^(sample-page|blog|portfolio|choosing-versatile-fishing-rods-and-pack-rods-for-easy-and-portable-setups|feed|comments/feed|wp-admin|wp-login\.php|wp-json|wp-content|wp-includes|xmlrpc\.php|wp-sitemap.*\.xml)(/.*)?$ - [G,L]
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
	# Vite fingerprints everything in /assets, so it can be cached for a year.
	<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png|jpg|svg|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(html|xml|txt|webmanifest)$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
